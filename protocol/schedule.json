{
  "schema_version": "1.0.0",
  "timezone": "Asia/Shanghai",
  "trial_weeks": 4,
  "effective_from": "2026-11-24",
  "bootstrap_week": {
    "week": "2026-W48",
    "report_deadline": "2026-11-24T16:00:00+08:00",
    "tuesday_meeting": "2026-11-24T19:00:00+08:00",
    "tuesday_format": "all_members_transition_kickoff",
    "notes": "本周二先按全员提交+今晚统一启动；从下周起启用周二路由制与提前24小时冻结机制。"
  },
  "weekly_rhythm": [
    {
      "day": "Monday",
      "time": "18:00",
      "event": "weekly_report_due",
      "owner": "all_students",
      "description": "提交 weekly/<YYYY-Www>/{meta.yaml, evidence.md, judgment.md}；缺 judgment.md 视为未提交。"
    },
    {
      "day": "Monday_to_Tuesday",
      "time": "18:00-18:00",
      "event": "ai_preread_and_routing",
      "owner": "secretary_and_advisor",
      "description": "AI 预读全部周报，秘书排出周二路由时段与周四决策事项，老师异步在 reviews/ 批示。"
    },
    {
      "day": "Tuesday",
      "time": "19:00",
      "event": "tuesday_routing_session",
      "owner": "routed_members_only",
      "description": "90分钟拆4个约20分钟时段，只用于1:1或2-4人小组阻塞排查，未被排到不参会。同时周四受评审的2个课题提交预读材料。"
    },
    {
      "day": "Thursday",
      "time": "19:00",
      "event": "thursday_deep_review",
      "owner": "external_scientists_phd_and_reviewed_masters",
      "description": "75分钟：2个课题深度评审（5分钟陈述+25分钟讨论）+15分钟研究决策。进度在周三19:00前（提前24h）冻结。"
    },
    {
      "day": "Friday",
      "time": "21:00",
      "event": "product_update_due",
      "owner": "phd_and_product_team",
      "description": "有产品任务的成员更新 weekly/<YYYY-Www>/product.md。"
    },
    {
      "day": "Saturday",
      "time": "21:00",
      "event": "saturday_product_review",
      "owner": "product_group_and_phd",
      "description": "60分钟：20分钟可演示Demo展示+25分钟产品决策+15分钟下周交付物对齐（每月最后一个周六为联合演示日）。"
    }
  ],
  "freeze_rule": "任何受评审材料须至少提前 24 小时冻结并完成提交；临时新增进度不带入当场会议。"
}
